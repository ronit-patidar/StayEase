<% layout("/layouts/boilerplate.ejs") %>

<div class="row mt-3">
  <div class="col-8 offset-2">


<h3 class="mb-3">Listing Details</h3>

<div class="card">
  
  <img 
    src="<%= listing.image %>" 
    class="card-img-top" 
    alt="listing image"
    style="height: 300px; object-fit: cover;"
  >

  <div class="card-body">

    <h4 class="card-title">
      <%= listing.title %>
    </h4>

    <p class="card-text">
      <%= listing.description %>
    </p>

    <p class="card-text">
      <strong>Price:</strong>
      &#8377;<%= listing.price.toLocaleString("en-IN") %>
    </p>

    <p class="card-text">
      <strong>Location:</strong>
      <%= listing.location %>
    </p>

    <p class="card-text">
      <strong>Country:</strong>
      <%= listing.country %>
    </p>

    <div class="d-flex gap-2 mt-4">

      <a 
        href="/listings/<%= listing._id %>/edit" 
        class="btn btn-dark"
      >
        Edit this listing
      </a>

      <form 
        method="POST" 
        action="/listings/<%= listing._id %>?_method=DELETE"
      >
        <button class="btn btn-danger">
          Delete this listing
        </button>
      </form>

    </div>

  </div>
</div>


  </div>
</div>
